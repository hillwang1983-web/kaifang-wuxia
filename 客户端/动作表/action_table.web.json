  {
   "if": {
    "modelNotIn": [
     1,
     2,
     128
    ],
    "seriesNotIn": [
     "B",
     "F"
    ]
   },
   "map": {
    "5": 4,
    "6": 4
   }
  },
  {
   "if": {
    "modelIn": [
     6,
     7,
     8,
     132,
     133,
     134
    ]
   },
   "map": {
    "3": 2
   }
  },
  {
   "if": {
    "seriesIn": [
     "B",
     "F"
    ]
   },
   "map": {
    "2": 4,
    "3": 4,
    "5": 4,
    "6": 4
   }
  }
