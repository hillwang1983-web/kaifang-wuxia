{
  "name": "kaifang-wuxia",
  "private": true,
  "version": "0.4.0",
  "description": "开放武侠多端协作与青石渡风波验证入口",
  "scripts": {
    "serve": "node portal-integration/server.mjs",
    "test": "node --test tests/chapter.test.cjs tests/playtest.test.cjs portal-integration/server.test.mjs tests/preview-release.test.mjs",
    "test:browser": "node --test --test-concurrency=1 --test-timeout=60000 tests/browser.test.mjs tests/mobile-browser.test.mjs",
    "test:all": "npm test && npm run test:browser",
    "test:server": "python3 -m unittest discover -s 服务端/tests -t 服务端",
    "update:preview": "node scripts/update-preview.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
